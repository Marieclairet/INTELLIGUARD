import mongoose from "mongoose";

const cameraSnapshotSchema = new mongoose.Schema({
  image: {
    type: Buffer,
    required: true,
  },
  contentType: {
    type: String,
    default: "image/jpeg",
  },
  date: {
    type: Date,
    default: Date.now,
  },
});

const CameraSnapshot = mongoose.model("CameraSnapshot", cameraSnapshotSchema);

export default CameraSnapshot;
